---
import Layout from '../layouts/Layout.astro';
import { cvData } from '../data/cv';
import { url } from '../utils/paths';
---

<Layout 
  title={`${cvData.name} — ${cvData.title}`} 
  description={cvData.summary}
>
  <div class="content-container pt-12 sm:pt-20 space-y-24 sm:space-y-32">
    
    <!-- 1. HERO / ABOUT INTRO (SPACIOUS & ELEGANT) -->
    <section class="space-y-8">
      <div class="flex items-center gap-6">
        <img 
          src={url(cvData.photo)} 
          alt={cvData.name} 
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border border-[var(--border)] shrink-0 shadow-xs"
        />
        <div class="space-y-1">
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text)]">
            {cvData.name}
          </h1>
          <p class="text-sm sm:text-base font-medium text-[var(--text-secondary)]">
            Desarrollo de Software • Analista de Sistemas • Abogada (UCA)
          </p>
        </div>
      </div>

      <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed font-normal max-w-2xl">
        {cvData.summary}
      </p>

      <!-- SOCIAL & ACTION PILLS -->
      <div class="flex flex-wrap items-center gap-3 pt-2 text-xs sm:text-sm">
        <a href={url('/cv')} class="btn-minimal btn-minimal-primary font-semibold">
          <span>📄</span>
          <span>Curriculum Vitae (PDF)</span>
        </a>
        <a href={`mailto:${cvData.email}`} class="btn-minimal">
          <span>✉</span>
          <span>{cvData.email}</span>
        </a>
        <a href={cvData.github} target="_blank" rel="noopener noreferrer" class="btn-minimal">
          <span>GitHub ↗</span>
        </a>
        <a href={cvData.linkedin} target="_blank" rel="noopener noreferrer" class="btn-minimal">
          <span>LinkedIn ↗</span>
        </a>
      </div>
    </section>

    <!-- 2. EXPERIENCIA LABORAL -->
    <section id="experiencia" class="space-y-10 pt-10 border-t border-[var(--border)]">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold tracking-tight text-[var(--text)]">
          Experiencia Laboral
        </h2>
        <span class="text-xs text-[var(--text-faint)]">Trayectoria profesional</span>
      </div>

      <div class="space-y-12 sm:space-y-14">
        {cvData.experience.map((exp) => (
          <div class="space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 pb-1 border-b border-[var(--border-subtle)]">
              <div>
                <h3 class="text-base font-semibold text-[var(--text)]">
                  {exp.role}
                </h3>
                <span class="text-sm font-medium text-[var(--text-secondary)]">
                  {exp.company} {exp.location && `• ${exp.location}`}
                </span>
              </div>
              <span class="text-xs font-mono text-[var(--text-faint)] shrink-0">
                {exp.period}
              </span>
            </div>

            <ul class="space-y-2.5 pl-5 list-disc text-sm text-[var(--text-secondary)] leading-relaxed pt-1">
              {exp.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. PROYECTOS DESTACADOS (GITHUB @LBYACHE) -->
    <section id="proyectos" class="space-y-10 pt-10 border-t border-[var(--border)]">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold tracking-tight text-[var(--text)]">
          Proyectos Seleccionados
        </h2>
        <a 
          href={cvData.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-xs text-[var(--text-muted)] hover:text-[var(--text)] transition-colors inline-flex items-center gap-1"
        >
          <span>github.com/{cvData.githubUsername}</span>
          <span>↗</span>
        </a>
      </div>

      <div class="space-y-4 sm:space-y-5">
        {cvData.projects.map((proj) => (
          <a 
            href={proj.github} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="interactive-row group"
          >
            <div class="flex items-baseline justify-between gap-2">
              <span class="text-base font-semibold text-[var(--text)] group-hover:underline decoration-1 underline-offset-4">
                {proj.title}
              </span>
              <span class="text-xs text-[var(--text-faint)] group-hover:text-[var(--text)] transition-colors font-mono">
                ↗
              </span>
            </div>

            <p class="text-sm text-[var(--text-secondary)] mt-1.5 mb-3 leading-relaxed">
              {proj.description}
            </p>

            <div class="flex flex-wrap gap-2">
              {proj.tech.map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 4. STACK & TECNOLOGÍAS -->
    <section id="skills" class="space-y-8 pt-10 border-t border-[var(--border)]">
      <h2 class="text-lg font-bold tracking-tight text-[var(--text)]">
        Stack &amp; Habilidades
      </h2>

      <div class="space-y-6 text-sm">
        <div class="space-y-2.5">
          <span class="text-xs font-semibold text-[var(--text-muted)] block uppercase tracking-wider">
            Lenguajes y Frameworks:
          </span>
          <div class="flex flex-wrap gap-2">
            {cvData.technologies.languagesAndFrameworks.map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        </div>

        <div class="space-y-2.5">
          <span class="text-xs font-semibold text-[var(--text-muted)] block uppercase tracking-wider">
            Herramientas y Plataformas:
          </span>
          <div class="flex flex-wrap gap-2">
            {cvData.technologies.tools.map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        </div>

        <div class="space-y-2.5">
          <span class="text-xs font-semibold text-[var(--text-muted)] block uppercase tracking-wider">
            Habilidades de Gestión:
          </span>
          <div class="flex flex-wrap gap-2">
            {cvData.softSkills.map((s) => (
              <span class="tech-tag">{s}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 5. EDUCACIÓN & VOLUNTARIADO -->
    <section id="educacion" class="space-y-8 pt-10 border-t border-[var(--border)]">
      <h2 class="text-lg font-bold tracking-tight text-[var(--text)]">
        Educación &amp; Voluntariado
      </h2>

      <div class="space-y-6">
        {cvData.education.map((edu) => (
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 text-sm pb-2 border-b border-[var(--border-subtle)]">
            <div>
              <strong class="font-semibold text-[var(--text)]">{edu.degree}</strong>
              <span class="text-[var(--text-muted)]"> — {edu.institution}</span>
            </div>
            <span class="font-mono text-xs text-[var(--text-faint)] shrink-0">
              {edu.period}
            </span>
          </div>
        ))}

        <div class="pt-4">
          {cvData.volunteering.map((v) => (
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 text-sm">
              <div>
                <strong class="font-semibold text-[var(--text)]">{v.organization}</strong>
                <span class="text-[var(--text-muted)]"> ({v.role})</span>
                <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1 leading-relaxed">{v.description}</p>
              </div>
              <span class="font-mono text-xs text-[var(--text-faint)] shrink-0">
                {v.period}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. CONTACTO & CIERRE -->
    <section class="pt-10 border-t border-[var(--border)] text-sm text-[var(--text-secondary)] space-y-4">
      <h2 class="text-lg font-bold tracking-tight text-[var(--text)]">
        Contacto
      </h2>
      <p class="leading-relaxed">
        Abierta a oportunidades en desarrollo backend (.NET / C#), desarrollo mobile (iOS / Swift), docencia tecnológica y proyectos de LegalTech.
      </p>
      <p>
        Puedes escribirme a <a href={`mailto:${cvData.email}`} class="text-[var(--text)] font-semibold underline underline-offset-4 hover:opacity-80">{cvData.email}</a> o conectar a través de <a href={cvData.linkedin} target="_blank" rel="noopener noreferrer" class="text-[var(--text)] font-semibold underline underline-offset-4 hover:opacity-80">LinkedIn</a> y <a href={cvData.github} target="_blank" rel="noopener noreferrer" class="text-[var(--text)] font-semibold underline underline-offset-4 hover:opacity-80">GitHub</a>.
      </p>
    </section>

  </div>
</Layout>
