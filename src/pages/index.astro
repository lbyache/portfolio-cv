---
import Layout from '../layouts/Layout.astro';
import { cvData } from '../data/cv';
import { url } from '../utils/paths';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import { getCollection } from 'astro:content';

// Get latest blog posts
const posts = await getCollection('blog');
const sortedPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const featuredProjects = cvData.projects.filter(p => p.featured).slice(0, 4);
---

<Layout 
  title={`${cvData.name} — ${cvData.title}`} 
  description={cvData.summary}
>
  <!-- HERO SECTION -->
  <section class="py-6 sm:py-12 mb-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- HERO TEXT & INTRO (7 COLS) -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <div class="section-prompt mb-4">
          perfil_profesional/
        </div>

        <h1 class="mb-6 leading-[1.1] tracking-tight">
          <span class="block text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[var(--text-primary)] font-sans">
            Desarrollo de Software
          </span>
          <span class="block text-3xl sm:text-4xl lg:text-5xl font-serif italic font-normal text-[var(--text-primary)] mt-2">
            &amp; Análisis de Sistemas.
          </span>
        </h1>

        <!-- TECH PILLS -->
        <div class="flex flex-wrap gap-2.5 mb-8">
          <span class="dashed-pill">
            <span class="text-xs">⚡</span>
            <span>C# / .NET</span>
          </span>
          <span class="dashed-pill">
            <span class="text-xs">📱</span>
            <span>iOS (Swift &amp; SwiftUI)</span>
          </span>
          <span class="dashed-pill">
            <span class="text-xs">⚖️</span>
            <span>LegalTech &amp; IA</span>
          </span>
          <span class="dashed-pill">
            <span class="text-xs">👩‍💻</span>
            <span>Voluntaria MeT</span>
          </span>
        </div>

        <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed mb-10 max-w-xl">
          {cvData.summary}
        </p>

        <!-- CTA BUTTONS -->
        <div class="flex flex-wrap items-center gap-4">
          <a href={url('/cv')} class="btn text-sm py-3 px-6">
            <span>📄</span>
            <span>[ver_cv_imprimible]</span>
          </a>
          <a href="#proyectos" class="btn btn-outline text-sm py-3 px-6">
            <span>↓</span>
            <span>[proyectos_destacados]</span>
          </a>
          <a href={`mailto:${cvData.email}`} class="btn btn-outline text-sm py-3 px-5">
            <span>✉</span>
            <span>[contacto]</span>
          </a>
        </div>
      </div>

      <!-- HERO PHOTO CARD (5 COLS) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="card p-6 sm:p-8 w-full max-w-sm text-center border-2 border-[var(--border-color)] bg-[var(--bg-surface)] relative group">
          
          <!-- STATUS PILL -->
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[var(--bg-primary)] border border-[var(--border-color)] px-3.5 py-1 rounded-full shadow-sm flex items-center gap-2 text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-medium text-[var(--text-primary)]">Disponible para proyectos</span>
          </div>

          <div class="mt-3 mb-6 relative inline-block">
            <img 
              src={url(cvData.photo)} 
              alt={cvData.name} 
              class="w-36 h-36 sm:w-44 sm:h-44 rounded-full mx-auto object-cover border-4 border-[var(--border-color)] shadow-md group-hover:scale-102 transition-transform duration-300"
            />
          </div>

          <h2 class="font-serif font-bold text-2xl text-[var(--text-primary)] mb-1">
            {cvData.name}
          </h2>
          <p class="font-mono text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-4">
            {cvData.title}
          </p>

          <div class="pt-4 border-t border-[var(--border-color)] flex justify-around text-xs font-mono text-[var(--text-secondary)]">
            <a href={cvData.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)] font-bold flex items-center gap-1">
              <span>GitHub</span>
              <span>↗</span>
            </a>
            <span>•</span>
            <a href={cvData.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)] font-bold flex items-center gap-1">
              <span>LinkedIn</span>
              <span>↗</span>
            </a>
            <span>•</span>
            <a href={`mailto:${cvData.email}`} class="hover:text-[var(--text-primary)] font-bold flex items-center gap-1">
              <span>Email</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- TERMINAL FOOTER BAR -->
    <div class="mt-14 pt-6 border-t border-[var(--border-color)] flex flex-wrap justify-between items-center gap-4 font-mono text-xs text-[var(--text-muted)]">
      <div>// Axoft (.NET Backend) • Da Vinci (Docencia) • MeT • UCA Abogacía</div>
      <div class="flex items-center gap-2">
        <span>📍</span>
        <span>Ciudad Autónoma de Buenos Aires, Argentina</span>
      </div>
    </div>
  </section>

  <!-- DUAL PROFILE BENTO CARDS -->
  <section class="mb-24">
    <div class="section-prompt mb-3">perfil_multidisciplinario/</div>
    <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--text-primary)] mb-8">
      Sinergia Técnica, Académica y Comunitaria
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="card card-hover flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="font-mono text-xs font-bold text-[var(--text-muted)]">// 01. SISTEMAS</span>
            <span class="badge text-xs">C# &amp; iOS</span>
          </div>
          <h3 class="font-sans font-bold text-xl text-[var(--text-primary)] mb-3">
            Ingeniería de Software &amp; Backend
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Analista de Sistemas y desarrolladora backend en Axoft Argentina. Mantenimiento y arquitectura de software de gestión empresarial con C#/.NET, optimización SQL y desarrollo mobile nativo con Swift y SwiftUI.
          </p>
        </div>
        <div class="pt-4 border-t border-[var(--border-color)] flex flex-wrap gap-1.5">
          <span class="badge text-[11px]">C# .NET</span>
          <span class="badge text-[11px]">SQL Server</span>
          <span class="badge text-[11px]">SwiftUI</span>
          <span class="badge text-[11px]">SOLID</span>
        </div>
      </div>

      <div class="card card-hover flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="font-mono text-xs font-bold text-[var(--text-muted)]">// 02. LEGALTECH</span>
            <span class="badge text-xs">Derecho &amp; IA</span>
          </div>
          <h3 class="font-sans font-bold text-xl text-[var(--text-primary)] mb-3">
            Base Jurídica &amp; Análisis Funcional
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Graduada en Abogacía (UCA) con trayectoria en LegalTech (DHL Express). Capacidad analítica para traducir marcos normativos y regulatorios complejos en requerimientos técnicos de software y flujos automatizados.
          </p>
        </div>
        <div class="pt-4 border-t border-[var(--border-color)] flex flex-wrap gap-1.5">
          <span class="badge text-[11px]">Power Platform</span>
          <span class="badge text-[11px]">LegalTech</span>
          <span class="badge text-[11px]">Ética en IA</span>
          <span class="badge text-[11px]">Automatización</span>
        </div>
      </div>

      <div class="card card-hover flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="font-mono text-xs font-bold text-[var(--text-muted)]">// 03. COMUNIDAD</span>
            <span class="badge text-xs">Docencia &amp; MeT</span>
          </div>
          <h3 class="font-sans font-bold text-xl text-[var(--text-primary)] mb-3">
            Docencia Web &amp; Inclusión Tech
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Docente de programación y desarrollo web en Escuela Da Vinci. Colaboradora activa en Mujeres en Tecnología (MeT), impulsando activamente la inclusión, mentoría y diversidad en la comunidad tecnológica.
          </p>
        </div>
        <div class="pt-4 border-t border-[var(--border-color)] flex flex-wrap gap-1.5">
          <span class="badge text-[11px]">Docencia Web</span>
          <span class="badge text-[11px]">Comunidad MeT</span>
          <span class="badge text-[11px]">Mentoría</span>
          <span class="badge text-[11px]">JavaScript</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section id="proyectos" class="mb-24">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <div class="section-prompt mb-2">codigo_y_repositorios/</div>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--text-primary)]">
          Proyectos &amp; Repositorios Destacados
        </h2>
      </div>
      <a 
        href={cvData.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="font-mono text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1.5 border-b border-[var(--border-color)] pb-1 hover:border-[var(--text-primary)] transition-colors"
      >
        <span>[ver_todos_en_github (@{cvData.githubUsername})]</span>
        <span>↗</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featuredProjects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- CAREER TIMELINE HIGHLIGHT -->
  <section class="mb-24">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <div class="section-prompt mb-2">trayectoria_laboral/</div>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--text-primary)]">
          Experiencia Profesional Principal
        </h2>
      </div>
      <a href={url('/cv')} class="btn btn-outline text-xs">
        [ver_cv_completo_con_educacion] →
      </a>
    </div>

    <div class="card p-8 sm:p-10">
      <div class="space-y-8">
        {cvData.experience.slice(0, 4).map(exp => (
          <ExperienceCard item={exp} />
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST ESSAYS / BLOG -->
  {sortedPosts.length > 0 && (
    <section class="mb-16">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <div class="section-prompt mb-2">articulos_y_ensayos/</div>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--text-primary)]">
            Reflexiones sobre Tecnología, Ética e IA
          </h2>
        </div>
        <a href={url('/blog')} class="font-mono text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1">
          [ver_todos_los_ensayos] →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedPosts.map(post => (
          <article class="card card-hover flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <div class="flex flex-wrap gap-1.5">
                  {post.data.tags.map(tag => (
                    <span class="badge text-[11px]">#{tag}</span>
                  ))}
                </div>
                <span class="font-mono text-xs text-[var(--text-muted)]">
                  {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </div>

              <h3 class="font-sans font-bold text-xl text-[var(--text-primary)] mb-3 leading-snug">
                <a href={url(`/blog/${post.id}`)} class="text-inherit no-underline hover:underline">
                  {post.data.title}
                </a>
              </h3>

              <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
                {post.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-[var(--border-color)] text-right">
              <a href={url(`/blog/${post.id}`)} class="font-mono text-xs font-bold text-[var(--text-primary)] hover:underline inline-flex items-center gap-1">
                [leer_ensayo_completo] →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>
