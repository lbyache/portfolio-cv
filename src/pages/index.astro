---
import Layout from '../layouts/Layout.astro';
import { cvData } from '../data/cv';
import { url } from '../utils/paths';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import { getCollection } from 'astro:content';

// Get latest blog posts
const posts = await getCollection('blog');
const sortedPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const featuredProjects = cvData.projects.filter(p => p.featured).slice(0, 4);
---

<Layout 
  title={`${cvData.name} — ${cvData.title}`} 
  description={cvData.summary}
>
  <!-- HERO SECTION -->
  <section class="mb-20 pt-4">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- HERO TEXT & INTRO (8 COLS) -->
      <div class="lg:col-span-8">
        <div class="section-prompt">
          perfil_profesional/
        </div>

        <h1 class="mb-6 leading-[1.05] tracking-tight">
          <span class="block text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[var(--text-primary)] font-sans">
            Desarrollo de Software
          </span>
          <span class="block text-3xl sm:text-4xl lg:text-5xl font-serif italic font-normal text-[var(--text-primary)] mt-1">
            &amp; Análisis de Sistemas.
          </span>
        </h1>

        <!-- TECH BADGES -->
        <div class="flex flex-wrap gap-2 mb-6">
          <span class="dashed-pill">#C# / .NET</span>
          <span class="dashed-pill">#iOS (Swift &amp; SwiftUI)</span>
          <span class="dashed-pill">#Docencia Tech</span>
          <span class="dashed-pill">#LegalTech &amp; IA</span>
          <span class="dashed-pill">#Voluntariado MeT</span>
        </div>

        <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed mb-8 max-w-2xl">
          {cvData.summary}
        </p>

        <!-- CTA BUTTONS -->
        <div class="flex flex-wrap items-center gap-3.5">
          <a href={url('/cv')} class="btn">
            <span>📄</span>
            <span>[ver_cv_imprimible]</span>
          </a>
          <a href="#proyectos" class="btn btn-outline">
            [explorar_proyectos] ↓
          </a>
          <a href={`mailto:${cvData.email}`} class="btn btn-outline">
            [contacto_email] ↗
          </a>
        </div>
      </div>

      <!-- HERO PHOTO CARD (4 COLS) -->
      <div class="lg:col-span-4 flex flex-col items-center lg:items-end">
        <div class="card p-4 sm:p-5 max-w-xs text-center border-2 border-[var(--border-color)] bg-[var(--bg-surface)]">
          <img 
            src={url(cvData.photo)} 
            alt={cvData.name} 
            class="w-36 h-36 sm:w-44 sm:h-44 rounded-full mx-auto object-cover border-2 border-[var(--border-color)] shadow-sm mb-4"
          />
          <h2 class="font-sans font-bold text-base text-[var(--text-primary)] mb-0.5">
            {cvData.name}
          </h2>
          <p class="font-mono text-xs text-[var(--text-muted)] mb-3">
            @{cvData.githubUsername} • CABA, AR
          </p>
          <div class="pt-3 border-t border-[var(--border-color)] flex justify-center gap-3 text-xs font-mono">
            <a href={cvData.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)]">GitHub ↗</a>
            <span>•</span>
            <a href={cvData.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)]">LinkedIn ↗</a>
          </div>
        </div>
      </div>

    </div>

    <!-- TERMINAL FOOTER LINE -->
    <div class="mt-12 pt-4 border-t border-[var(--border-color)] flex flex-wrap justify-between items-center gap-3 font-mono text-xs text-[var(--text-muted)]">
      <div>// Axoft (.NET) • Da Vinci (Docente) • MeT • UCA Abogacía</div>
      <div class="flex items-center gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Disponible para colaboraciones</span>
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section id="proyectos" class="mb-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="section-prompt">codigo_y_repositorios/</div>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[var(--text-primary)]">
          Proyectos &amp; Código Destacado
        </h2>
      </div>
      <a 
        href={cvData.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="font-mono text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1"
      >
        [ver_todos_en_github ({cvData.githubUsername})] ↗
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- DUAL BACKGROUND (TECH + ACADEMIC / LEGAL) -->
  <section class="mb-20">
    <div class="section-prompt">perfil_dual/</div>
    <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[var(--text-primary)] mb-6">
      Sinergia Técnica, Académica y Comunitaria
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card card-hover flex flex-col justify-between">
        <div>
          <span class="font-mono text-xs font-bold text-[var(--text-muted)] block mb-2">// 01. DESARROLLO &amp; SISTEMAS</span>
          <h3 class="font-sans font-bold text-lg text-[var(--text-primary)] mb-2">
            Ingeniería de Software &amp; C#
          </h3>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Formación como Analista de Sistemas y experiencia en backend empresarial con C# y .NET en Axoft. Desarrollo mobile nativo en iOS con Swift y SwiftUI.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-[var(--border-color)]">
          <span class="badge text-[11px]">Backend &amp; Mobile</span>
        </div>
      </div>

      <div class="card card-hover flex flex-col justify-between">
        <div>
          <span class="font-mono text-xs font-bold text-[var(--text-muted)] block mb-2">// 02. LEGALTECH &amp; ÉTICA</span>
          <h3 class="font-sans font-bold text-lg text-[var(--text-primary)] mb-2">
            Base Jurídica &amp; Análisis Funcional
          </h3>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Graduada en Abogacía (UCA) con trayectoria en LegalTech (DHL Express). Capacidad para interpretar normativas complejas, automatizar procesos y abordar la ética en IA.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-[var(--border-color)]">
          <span class="badge text-[11px]">LegalTech &amp; AI Ethics</span>
        </div>
      </div>

      <div class="card card-hover flex flex-col justify-between">
        <div>
          <span class="font-mono text-xs font-bold text-[var(--text-muted)] block mb-2">// 03. DOCENCIA &amp; COMUNIDAD</span>
          <h3 class="font-sans font-bold text-lg text-[var(--text-primary)] mb-2">
            Docencia Web &amp; Mujeres en Tecnología
          </h3>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Docente de desarrollo web en Da Vinci y miembro activa de MeT (Mujeres en Tecnología), promoviendo la inclusión, diversidad y mentoría técnica.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-[var(--border-color)]">
          <span class="badge text-[11px]">Comunidad &amp; Docencia</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CAREER TIMELINE HIGHLIGHT -->
  <section class="mb-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="section-prompt">trayectoria/</div>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[var(--text-primary)]">
          Experiencia Laboral Principal
        </h2>
      </div>
      <a href={url('/cv')} class="btn btn-outline text-xs">
        [ver_cv_completo] →
      </a>
    </div>

    <div class="card p-6 sm:p-8">
      <div class="space-y-6">
        {cvData.experience.slice(0, 4).map(exp => (
          <ExperienceCard item={exp} />
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST BLOG POSTS -->
  {sortedPosts.length > 0 && (
    <section class="mb-12">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="section-prompt">articulos_y_ensayos/</div>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[var(--text-primary)]">
            Reflexiones sobre Tecnología, Ética e IA
          </h2>
        </div>
        <a href={url('/blog')} class="font-mono text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
          [ver_todos_los_ensayos] →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {sortedPosts.map(post => (
          <article class="card card-hover flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex flex-wrap gap-1">
                  {post.data.tags.map(tag => (
                    <span class="badge text-[11px]">#{tag}</span>
                  ))}
                </div>
                <span class="font-mono text-xs text-[var(--text-muted)]">
                  {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </div>

              <h3 class="font-sans font-bold text-lg text-[var(--text-primary)] mb-2">
                <a href={url(`/blog/${post.id}`)} class="text-inherit no-underline hover:underline">
                  {post.data.title}
                </a>
              </h3>

              <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>

            <div class="pt-3 border-t border-[var(--border-color)] text-right">
              <a href={url(`/blog/${post.id}`)} class="font-mono text-xs font-bold text-[var(--text-primary)] hover:underline">
                [leer_ensayo] →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>
