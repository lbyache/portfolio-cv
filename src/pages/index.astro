---
import Layout from '../layouts/Layout.astro';
import { cvData } from '../data/cv';
import { url } from '../utils/paths';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import EducationCard from '../components/EducationCard.astro';
---

<Layout 
  title={`${cvData.name} — ${cvData.title}`} 
  description={cvData.summary}
>
  <!-- HERO SECTION -->
  <section class="py-10 sm:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- HERO CONTENT (7 COLS) -->
      <div class="lg:col-span-7">
        
        <!-- AVAILABILITY BADGE -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] text-xs font-semibold text-[var(--text-secondary)] shadow-xs mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Disponible para nuevas oportunidades</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[var(--text-primary)] tracking-tight leading-[1.1] mb-4">
          {cvData.name}
        </h1>

        <p class="text-lg sm:text-xl font-bold text-[var(--accent-blue)] mb-6">
          Desarrollo de Software • Analista de Sistemas • Abogada (UCA)
        </p>

        <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed mb-8 max-w-xl">
          {cvData.summary}
        </p>

        <!-- QUICK CONTACT PILLS -->
        <div class="flex flex-wrap gap-2.5 mb-8 text-xs font-medium text-[var(--text-secondary)]">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-[var(--bg-surface)] border border-[var(--border-color)]">
            📍 {cvData.location}
          </span>
          <a href={`mailto:${cvData.email}`} class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-[var(--bg-surface)] border border-[var(--border-color)] hover:text-[var(--text-primary)] hover:border-[var(--accent-blue)] transition-colors">
            ✉ {cvData.email}
          </a>
          <a href={cvData.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-[var(--bg-surface)] border border-[var(--border-color)] hover:text-[var(--text-primary)] hover:border-[var(--accent-blue)] transition-colors">
            git github.com/{cvData.githubUsername}
          </a>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="flex flex-wrap items-center gap-3.5">
          <a href={url('/cv')} class="btn py-3 px-6 shadow-sm">
            <span>📄</span>
            <span>Ver Curriculum Vitae (PDF)</span>
          </a>
          <a href="#proyectos" class="btn btn-outline py-3 px-5">
            <span>Explorar Proyectos ↓</span>
          </a>
          <a href={`mailto:${cvData.email}`} class="btn btn-outline py-3 px-5">
            <span>✉ Contactar</span>
          </a>
        </div>

      </div>

      <!-- HERO PHOTO CARD (5 COLS) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="card p-6 sm:p-7 w-full max-w-sm border border-[var(--border-color)] bg-[var(--bg-surface)] text-center relative group">
          
          <div class="relative inline-block mb-4">
            <img 
              src={url(cvData.photo)} 
              alt={cvData.name} 
              class="w-36 h-36 sm:w-40 sm:h-40 rounded-full mx-auto object-cover border-4 border-[var(--border-subtle)] shadow-md group-hover:scale-102 transition-transform duration-300"
            />
            <span class="absolute bottom-2 right-2 w-5 h-5 rounded-full bg-emerald-500 border-3 border-[var(--bg-surface)] shadow-xs"></span>
          </div>

          <h2 class="text-xl font-bold text-[var(--text-primary)] mb-1">
            {cvData.name}
          </h2>
          <p class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-4">
            {cvData.title}
          </p>

          <div class="flex flex-wrap justify-center gap-1.5 pt-4 border-t border-[var(--border-color)] text-xs">
            <span class="badge badge-blue">C# .NET</span>
            <span class="badge">iOS SwiftUI</span>
            <span class="badge">LegalTech</span>
            <span class="badge">MeT</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ESPECIALIDADES / ENFOQUE DUAL -->
  <section id="sobre-mi" class="py-14 border-t border-[var(--border-color)]">
    <div class="section-header text-center max-w-xl mx-auto mb-10">
      <span class="section-tag">Perfil Multidisciplinario</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
        Sinergia Técnica, Académica y Comunitaria
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="card card-hover p-7 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-5 border border-blue-100 dark:border-blue-900/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2">
            Backend &amp; C# .NET
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Mantenimiento y desarrollo de lógica empresarial en Axoft Argentina. Optimización de bases de datos SQL y arquitectura limpia con principios SOLID.
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-[var(--border-color)]">
          <span class="badge text-xs">C#</span>
          <span class="badge text-xs">.NET Core</span>
          <span class="badge text-xs">SQL Server</span>
        </div>
      </div>

      <div class="card card-hover p-7 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-5 border border-indigo-100 dark:border-indigo-900/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2">
            Mobile iOS (Swift)
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Desarrollo mobile nativo en iOS utilizando Swift y SwiftUI. Arquitectura MVVM, gestión de estado reactivo y consumo de APIs REST.
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-[var(--border-color)]">
          <span class="badge text-xs">Swift</span>
          <span class="badge text-xs">SwiftUI</span>
          <span class="badge text-xs">Xcode</span>
        </div>
      </div>

      <div class="card card-hover p-7 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-5 border border-emerald-100 dark:border-emerald-900/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2">
            LegalTech &amp; Docencia
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Abogada (UCA), automatización en DHL Express, docente de desarrollo web en Escuela Da Vinci y voluntaria en Mujeres en Tecnología (MeT).
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-[var(--border-color)]">
          <span class="badge text-xs">Power Platform</span>
          <span class="badge text-xs">Docencia Web</span>
          <span class="badge text-xs">MeT</span>
        </div>
      </div>

    </div>
  </section>

  <!-- EXPERIENCIA LABORAL -->
  <section id="experiencia" class="py-14 border-t border-[var(--border-color)]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <span class="section-tag">Trayectoria Profesional</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
          Experiencia Laboral
        </h2>
      </div>
      <a href={url('/cv')} class="btn btn-outline btn-sm text-xs">
        <span>📄</span>
        <span>Ver formato CV completo</span>
      </a>
    </div>

    <div class="card p-6 sm:p-9">
      <div class="space-y-6">
        {cvData.experience.map(exp => (
          <ExperienceCard item={exp} />
        ))}
      </div>
    </div>
  </section>

  <!-- PROYECTOS DESTACADOS -->
  <section id="proyectos" class="py-14 border-t border-[var(--border-color)]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <span class="section-tag">Código &amp; Repositorios</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
          Proyectos Destacados
        </h2>
      </div>
      <a 
        href={cvData.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1.5"
      >
        <span>Ver todos en GitHub (@{cvData.githubUsername})</span>
        <span>↗</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {cvData.projects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- STACK & SKILLS -->
  <section id="skills" class="py-14 border-t border-[var(--border-color)]">
    <div class="section-header text-center max-w-xl mx-auto mb-10">
      <span class="section-tag">Habilidades &amp; Herramientas</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
        Tecnologías &amp; Metodologías
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="card p-6">
        <h3 class="text-base font-bold text-[var(--text-primary)] mb-4 flex items-center gap-2">
          <span>💻</span>
          <span>Lenguajes &amp; Frameworks</span>
        </h3>
        <div class="flex flex-wrap gap-1.5">
          {cvData.technologies.languagesAndFrameworks.map(t => (
            <span class="badge text-xs">{t}</span>
          ))}
        </div>
      </div>

      <div class="card p-6">
        <h3 class="text-base font-bold text-[var(--text-primary)] mb-4 flex items-center gap-2">
          <span>🛠️</span>
          <span>Herramientas &amp; Plataformas</span>
        </h3>
        <div class="flex flex-wrap gap-1.5">
          {cvData.technologies.tools.map(t => (
            <span class="badge text-xs">{t}</span>
          ))}
        </div>
      </div>

      <div class="card p-6">
        <h3 class="text-base font-bold text-[var(--text-primary)] mb-4 flex items-center gap-2">
          <span>🤝</span>
          <span>Gestión &amp; Metodologías</span>
        </h3>
        <div class="flex flex-wrap gap-1.5">
          {cvData.softSkills.map(s => (
            <span class="badge text-xs">{s}</span>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- EDUCACIÓN & VOLUNTARIADO -->
  <section id="educacion" class="py-14 border-t border-[var(--border-color)]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- EDUCACIÓN (7 COLS) -->
      <div class="lg:col-span-7">
        <div class="section-header mb-6">
          <span class="section-tag">Formación Académica</span>
          <h2 class="text-2xl font-bold text-[var(--text-primary)]">
            Educación &amp; Cursos
          </h2>
        </div>
        <div class="card p-6 sm:p-8">
          <div class="space-y-3">
            {cvData.education.map(edu => (
              <EducationCard item={edu} />
            ))}
          </div>
        </div>
      </div>

      <!-- VOLUNTARIADO (5 COLS) -->
      <div class="lg:col-span-5">
        <div class="section-header mb-6">
          <span class="section-tag">Comunidad</span>
          <h2 class="text-2xl font-bold text-[var(--text-primary)]">
            Voluntariado
          </h2>
        </div>
        <div class="card p-6 sm:p-8">
          {cvData.volunteering.map(v => (
            <div>
              <div class="flex items-baseline justify-between gap-2 mb-2">
                <h3 class="text-base font-bold text-[var(--text-primary)]">{v.organization}</h3>
                <span class="badge text-xs">{v.period}</span>
              </div>
              <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
                {v.description}
              </p>
              <div class="pt-3 border-t border-[var(--border-color)] text-xs text-[var(--text-muted)]">
                Rol: <strong class="text-[var(--text-primary)]">{v.role}</strong>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CONTACTO BANNER -->
  <section class="py-16 my-8 rounded-2xl bg-gradient-to-br from-[var(--bg-surface)] to-[var(--bg-muted)] border border-[var(--border-color)] text-center p-8 sm:p-12 shadow-sm">
    <span class="section-tag mb-2">Contacto</span>
    <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-3">
      ¿Tienes un proyecto, propuesta o consulta?
    </h2>
    <p class="text-base text-[var(--text-secondary)] max-w-lg mx-auto mb-8">
      Abierta a oportunidades en desarrollo backend (.NET / C#), desarrollo mobile (iOS / Swift), docencia tecnológica y LegalTech.
    </p>
    <div class="flex flex-wrap justify-center items-center gap-3">
      <a href={`mailto:${cvData.email}`} class="btn py-3 px-6 shadow-sm">
        <span>✉</span>
        <span>Enviar correo ({cvData.email})</span>
      </a>
      <a href={cvData.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-outline py-3 px-6">
        <span>in Conectar en LinkedIn</span>
      </a>
    </div>
  </section>
</Layout>
