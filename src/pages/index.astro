---
import Layout from '../layouts/Layout.astro';
import { cvData } from '../data/cv';
import { url } from '../utils/paths';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import { getCollection } from 'astro:content';

// Get latest blog posts
const posts = await getCollection('blog');
const sortedPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const featuredProjects = cvData.projects.filter(p => p.featured).slice(0, 4);
---

<Layout 
  title={`${cvData.name} — ${cvData.title}`} 
  description={cvData.summary}
>
  <!-- MINIMALIST, HIGH-IMPACT HERO SECTION -->
  <section class="py-12 sm:py-20 max-w-4xl mx-auto text-center">
    
    <!-- AVATAR & AVAILABILITY BADGE -->
    <div class="inline-flex flex-col items-center mb-8">
      <div class="relative mb-4">
        <img 
          src={url(cvData.photo)} 
          alt={cvData.name} 
          class="w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover border-3 border-[var(--border-color)] shadow-md hover:scale-105 transition-transform duration-300"
        />
        <div class="absolute bottom-1 right-1 w-5 h-5 rounded-full bg-emerald-500 border-2 border-[var(--bg-surface)] flex items-center justify-center" title="Disponible para proyectos">
          <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
        </div>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] text-xs font-mono text-[var(--text-secondary)] shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Disponible para nuevos desafíos</span>
      </div>
    </div>

    <!-- MAIN HEADLINE -->
    <h1 class="text-4xl sm:text-6xl font-serif font-bold text-[var(--text-primary)] tracking-tight leading-[1.15] mb-6">
      Laura Belen Yachelini
    </h1>

    <p class="font-mono text-sm sm:text-base font-semibold text-[var(--text-muted)] uppercase tracking-widest mb-6">
      Desarrollo de Software • Analista de Sistemas • Abogada
    </p>

    <!-- FOCUSED ELEVATOR PITCH -->
    <p class="text-lg sm:text-xl text-[var(--text-secondary)] leading-relaxed max-w-2xl mx-auto mb-10 font-sans">
      Desarrollo soluciones de software robustas con <strong>C# y .NET</strong>, aplicaciones mobile nativas para <strong>iOS (Swift/SwiftUI)</strong> y aplico análisis de procesos con una sólida formación en <strong>LegalTech y docencia</strong>.
    </p>

    <!-- MAIN CALL TO ACTIONS -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href={url('/cv')} class="btn text-sm py-3 px-7 rounded-full shadow-md hover:shadow-lg">
        <span>📄</span>
        <span>Ver Curriculum Vitae</span>
      </a>
      <a href="#proyectos" class="btn btn-outline text-sm py-3 px-6 rounded-full">
        <span>Explorar Proyectos ↓</span>
      </a>
      <a href={`mailto:${cvData.email}`} class="btn btn-outline text-sm py-3 px-5 rounded-full">
        <span>✉ Contactar</span>
      </a>
    </div>

  </section>

  <!-- HIGHLIGHT AREAS (3 SPACIOUS, UNCLUTTERED PILLARS) -->
  <section class="py-12 border-t border-[var(--border-color)]">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <div class="card p-8 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[var(--bg-muted)] flex items-center justify-center text-lg mb-5 border border-[var(--border-color)]">
            💻
          </div>
          <h3 class="text-xl font-sans font-bold text-[var(--text-primary)] mb-2">
            Backend &amp; .NET
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Mantenimiento y desarrollo de lógica empresarial en C#/.NET en Axoft. Optimización de bases de datos SQL y principios SOLID.
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-[var(--border-color)]">
          <span class="badge text-xs">C#</span>
          <span class="badge text-xs">.NET</span>
          <span class="badge text-xs">SQL</span>
        </div>
      </div>

      <div class="card p-8 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[var(--bg-muted)] flex items-center justify-center text-lg mb-5 border border-[var(--border-color)]">
            📱
          </div>
          <h3 class="text-xl font-sans font-bold text-[var(--text-primary)] mb-2">
            Mobile iOS (Swift)
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Creación de aplicaciones nativas para iOS con SwiftUI y Xcode. Patrones reactivos (MVVM), diseño declarativo y APIs REST.
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-[var(--border-color)]">
          <span class="badge text-xs">Swift</span>
          <span class="badge text-xs">SwiftUI</span>
          <span class="badge text-xs">Xcode</span>
        </div>
      </div>

      <div class="card p-8 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[var(--bg-muted)] flex items-center justify-center text-lg mb-5 border border-[var(--border-color)]">
            ⚖️
          </div>
          <h3 class="text-xl font-sans font-bold text-[var(--text-primary)] mb-2">
            LegalTech &amp; Comunidad
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Abogada (UCA), automatización en DHL Express, docente de desarrollo web en Escuela Da Vinci y voluntaria en MeT.
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-[var(--border-color)]">
          <span class="badge text-xs">Power Platform</span>
          <span class="badge text-xs">Docencia</span>
          <span class="badge text-xs">MeT</span>
        </div>
      </div>

    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section id="proyectos" class="py-16 border-t border-[var(--border-color)]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <div class="section-prompt mb-2">proyectos_seleccionados/</div>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--text-primary)]">
          Código &amp; Repositorios
        </h2>
      </div>
      <a 
        href={cvData.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="font-mono text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1.5"
      >
        <span>Ver todos en GitHub (@{cvData.githubUsername})</span>
        <span>↗</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featuredProjects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- EXPERIENCE TIMELINE PREVIEW -->
  <section class="py-16 border-t border-[var(--border-color)]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <div class="section-prompt mb-2">trayectoria/</div>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--text-primary)]">
          Experiencia Laboral
        </h2>
      </div>
      <a href={url('/cv')} class="btn btn-outline text-xs rounded-full">
        Ver CV Completo con Educación →
      </a>
    </div>

    <div class="card p-8 sm:p-10">
      <div class="space-y-8">
        {cvData.experience.slice(0, 3).map(exp => (
          <ExperienceCard item={exp} />
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST ESSAYS / BLOG -->
  {sortedPosts.length > 0 && (
    <section class="py-16 border-t border-[var(--border-color)]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <div class="section-prompt mb-2">articulos_y_ensayos/</div>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--text-primary)]">
            Reflexiones &amp; Ensayos
          </h2>
        </div>
        <a href={url('/blog')} class="font-mono text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1">
          Ver todos los artículos →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedPosts.map(post => (
          <article class="card card-hover flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <div class="flex flex-wrap gap-1.5">
                  {post.data.tags.map(tag => (
                    <span class="badge text-[11px]">#{tag}</span>
                  ))}
                </div>
                <span class="font-mono text-xs text-[var(--text-muted)]">
                  {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </div>

              <h3 class="font-sans font-bold text-xl text-[var(--text-primary)] mb-3 leading-snug">
                <a href={url(`/blog/${post.id}`)} class="text-inherit no-underline hover:underline">
                  {post.data.title}
                </a>
              </h3>

              <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
                {post.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-[var(--border-color)] text-right">
              <a href={url(`/blog/${post.id}`)} class="font-mono text-xs font-bold text-[var(--text-primary)] hover:underline inline-flex items-center gap-1">
                Leer artículo completo →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>
