---
import '../styles/global.css';
import { cvData } from '../data/cv';
import { url } from '../utils/paths';

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    
    <title>{cvData.name} — {cvData.title}</title>
    <meta name="description" content={cvData.summary} />
    <meta name="author" content={cvData.name} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${cvData.name} — ${cvData.title}`} />
    <meta property="og:description" content={cvData.summary} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={url(cvData.photo)} />

    <!-- Dark Mode Hydration -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    
    <!-- FLOATING TOP TOOLBAR (NO-PRINT) -->
    <div class="no-print max-w-[960px] mx-auto mb-5 flex flex-wrap items-center justify-between gap-3 px-2">
      <div class="flex items-center gap-2 text-xs font-semibold text-[var(--text-muted)]">
        <span>Curriculum Vitae</span>
        <span>•</span>
        <span>{cvData.name}</span>
      </div>

      <div class="flex items-center gap-2">
        <button 
          id="theme-btn" 
          class="cv-btn cv-btn-outline text-xs py-1.5 px-3"
          aria-label="Cambiar tema"
        >
          <span id="theme-icon">◐</span>
          <span id="theme-text">Modo</span>
        </button>

        <a 
          href={cvData.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="cv-btn cv-btn-outline text-xs py-1.5 px-3"
        >
          GitHub ↗
        </a>

        <a 
          href={cvData.linkedin} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="cv-btn cv-btn-outline text-xs py-1.5 px-3"
        >
          LinkedIn ↗
        </a>

        <button 
          id="print-btn" 
          class="cv-btn cv-btn-primary text-xs py-1.5 px-3.5"
          onclick="window.print()"
        >
          <span>📄</span>
          <span>Descargar PDF</span>
        </button>
      </div>
    </div>

    <!-- MAIN CV DOCUMENT (MATCHING PDF STRUCTURE) -->
    <main class="cv-paper">
      
      <!-- HEADER -->
      <header class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--cv-blue)] tracking-tight">
          {cvData.name}
        </h1>
        <p class="text-xs sm:text-sm font-semibold tracking-wider text-[var(--text-muted)] uppercase mt-1">
          {cvData.title}
        </p>
        <div class="w-full h-[1.5px] bg-[var(--cv-line)] mt-3"></div>
      </header>

      <!-- 2-COLUMN LAYOUT -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
        
        <!-- LEFT COLUMN (4 COLS) -->
        <aside class="md:col-span-5 flex flex-col gap-6">
          
          <!-- PHOTO -->
          <div class="flex justify-center md:justify-start">
            <img 
              src={url(cvData.photo)} 
              alt={cvData.name} 
              class="w-32 h-32 sm:w-36 sm:h-36 rounded-full object-cover border border-[var(--border-card)] shadow-xs"
            />
          </div>

          <!-- SOBRE MI -->
          <section class="break-avoid">
            <h2 class="cv-section-title">Sobre mi</h2>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] leading-relaxed text-justify">
              {cvData.summary}
            </p>
          </section>

          <!-- CONTACTO -->
          <section class="break-avoid">
            <h2 class="cv-section-title">Contacto</h2>
            <ul class="space-y-2 text-xs sm:text-[13px] text-[var(--text-secondary)]">
              <li class="flex items-center gap-2">
                <span class="w-5 text-center font-bold text-[var(--cv-blue)] text-xs">in</span>
                <a href={cvData.linkedin} target="_blank" rel="noopener noreferrer" class="hover:underline text-[var(--cv-blue)] font-medium">
                  LinkedIn
                </a>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 text-center font-bold text-[var(--cv-blue)] text-xs">git</span>
                <a href={cvData.github} target="_blank" rel="noopener noreferrer" class="hover:underline text-[var(--cv-blue)] font-medium">
                  GitHub
                </a>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 text-center text-[var(--cv-blue)]">@</span>
                <a href={`mailto:${cvData.email}`} class="hover:underline">
                  {cvData.email}
                </a>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 text-center text-[var(--cv-blue)]">&lt;/&gt;</span>
                <a href={`https://${cvData.githubUsername}.github.io/portfolio-cv`} class="hover:underline">
                  Portfolio
                </a>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 text-center text-[var(--cv-blue)]">📍</span>
                <span>{cvData.location}</span>
              </li>
            </ul>
          </section>

          <!-- HABILIDADES -->
          <section class="break-avoid">
            <h2 class="cv-section-title">Habilidades</h2>
            <ul class="space-y-1.5 text-xs sm:text-[13px] text-[var(--text-secondary)]">
              {cvData.softSkills.map((skill) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--text-muted)] shrink-0"></span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </section>

          <!-- VOLUNTARIADO -->
          <section class="break-avoid">
            <h2 class="cv-section-title">Voluntariado</h2>
            <div>
              <strong class="block text-xs sm:text-[13px] font-bold text-[var(--text-main)] mb-0.5">
                MeT (Mujeres en tecnologia)
              </strong>
              <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] leading-relaxed">
                Organización comprometida con impulsar la inclusión y diversidad de género en el ecosistema tecnológico.
              </p>
            </div>
          </section>

        </aside>

        <!-- RIGHT COLUMN (7 COLS) -->
        <div class="md:col-span-7 flex flex-col gap-6">
          
          <!-- EDUCACIÓN -->
          <section class="break-avoid">
            <h2 class="cv-section-title">Educación</h2>
            <div class="space-y-4">
              
              <div class="flex items-start gap-2.5">
                <span class="cv-dot"></span>
                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-bold text-xs sm:text-[13px] text-[var(--text-main)] uppercase">
                      ANALISTA DE SISTEMAS
                    </h3>
                    <span class="text-xs text-[var(--text-muted)] font-medium">2023 - 2026</span>
                  </div>
                  <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                    Escuela de Arte Multimedial Da Vinci
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="cv-dot"></span>
                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-bold text-xs sm:text-[13px] text-[var(--text-main)] uppercase">
                      CURSO FULLSTACK NODE.JS
                    </h3>
                    <span class="text-xs text-[var(--text-muted)] font-medium">Febrero 2024</span>
                  </div>
                  <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                    Codo a codo
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="cv-dot"></span>
                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-bold text-xs sm:text-[13px] text-[var(--text-main)] uppercase">
                      BOOTCAMP FULLSTACK
                    </h3>
                    <span class="text-xs text-[var(--text-muted)] font-medium">Agosto 2024</span>
                  </div>
                  <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                    CILSA
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="cv-dot"></span>
                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-bold text-xs sm:text-[13px] text-[var(--text-main)] uppercase">
                      ABOGACIA
                    </h3>
                    <span class="text-xs text-[var(--text-muted)] font-medium">2012- 2017</span>
                  </div>
                  <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                    Universidad Católica Argentina
                  </p>
                </div>
              </div>

            </div>
          </section>

          <!-- EXPERIENCIA -->
          <section class="break-avoid">
            <h2 class="cv-section-title">Experiencia</h2>
            <div class="space-y-4">
              
              <!-- AXOFT -->
              <div class="flex items-start gap-2.5">
                <span class="cv-dot"></span>
                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-bold text-xs sm:text-[13px] text-[var(--text-main)]">
                      Desarrolladora C# .NET
                    </h3>
                    <span class="text-xs text-[var(--text-muted)] font-medium">2025 - Actualidad</span>
                  </div>
                  <p class="text-xs font-semibold text-[var(--text-secondary)] mb-1">
                    Axoft Argentina
                  </p>
                  <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] leading-relaxed">
                    • Desarrollar y mantener de aplicaciones empresariales utilizando C# y .NET. Participar en implementación de nuevas funcionalidades, corrección de bugs y trabajo en equipo.
                  </p>
                </div>
              </div>

              <!-- DA VINCI -->
              <div class="flex items-start gap-2.5">
                <span class="cv-dot"></span>
                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-bold text-xs sm:text-[13px] text-[var(--text-main)]">
                      Docente Desarrollo Web
                    </h3>
                    <span class="text-xs text-[var(--text-muted)] font-medium">2024 - Actualidad</span>
                  </div>
                  <p class="text-xs font-semibold text-[var(--text-secondary)] mb-1">
                    Escuela de Arte Multimedial Da Vinci
                  </p>
                  <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] leading-relaxed">
                    • Instruir en programación de desarrollo web (HTML-CSS-Javascript-Bootstrap)
                  </p>
                </div>
              </div>

              <!-- FREELANCE -->
              <div class="flex items-start gap-2.5">
                <span class="cv-dot"></span>
                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-bold text-xs sm:text-[13px] text-[var(--text-main)]">
                      Web Developer
                    </h3>
                    <span class="text-xs text-[var(--text-muted)] font-medium">2024 - 2025</span>
                  </div>
                  <p class="text-xs font-semibold text-[var(--text-secondary)] mb-1">
                    Freelance
                  </p>
                  <div class="text-xs sm:text-[13px] text-[var(--text-secondary)] leading-relaxed">
                    <p class="mb-0.5">Desarrollo de sitios web adaptables:</p>
                    <ul class="space-y-0.5 pl-3">
                      <li>• Entender necesidades del cliente y del público objetivo.</li>
                      <li>• Crear diseños que se ajusten a diferentes dispositivos.</li>
                      <li>• Analizar requerimientos de los clientes y proveer informes.</li>
                    </ul>
                  </div>
                </div>
              </div>

              <!-- DHL -->
              <div class="flex items-start gap-2.5">
                <span class="cv-dot"></span>
                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-bold text-xs sm:text-[13px] text-[var(--text-main)]">
                      Legal Tech Counsel
                    </h3>
                    <span class="text-xs text-[var(--text-muted)] font-medium">2018- 2023</span>
                  </div>
                  <p class="text-xs font-semibold text-[var(--text-secondary)] mb-1">
                    DHL Express
                  </p>
                  <ul class="space-y-0.5 text-xs sm:text-[13px] text-[var(--text-secondary)] leading-relaxed">
                    <li>• Asesorar legalmente de manera completa y colaborativa entre departamentos. Elaborar y revisar contratos comerciales.</li>
                    <li>• Desarrollar de automatizaciones de procesos internos utilizando Power Platform, actuando como nexo técnico entre las necesidades del área legal y la implementación de software.</li>
                  </ul>
                </div>
              </div>

              <!-- TROCCOLI -->
              <div class="flex items-start gap-2.5">
                <span class="cv-dot"></span>
                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-bold text-xs sm:text-[13px] text-[var(--text-main)]">
                      Legal Counsel Junior
                    </h3>
                    <span class="text-xs text-[var(--text-muted)] font-medium">2016- 2017</span>
                  </div>
                  <p class="text-xs font-semibold text-[var(--text-secondary)] mb-1">
                    Estudio Juridico Troccoli
                  </p>
                  <ul class="space-y-0.5 text-xs sm:text-[13px] text-[var(--text-secondary)] leading-relaxed">
                    <li>• Analizar jurídicamente consultas a clientes</li>
                    <li>• Supervisar, controlar y seguir casos</li>
                  </ul>
                </div>
              </div>

              <!-- BIOETICA -->
              <div class="flex items-start gap-2.5">
                <span class="cv-dot"></span>
                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-bold text-xs sm:text-[13px] text-[var(--text-main)]">
                      Auxiliar de investigación
                    </h3>
                    <span class="text-xs text-[var(--text-muted)] font-medium">2015- 2017</span>
                  </div>
                  <p class="text-xs font-semibold text-[var(--text-secondary)] mb-1">
                    Centro de Bioética, Persona y Familia
                  </p>
                  <ul class="space-y-0.5 text-xs sm:text-[13px] text-[var(--text-secondary)] leading-relaxed">
                    <li>• Investigar la normativa jurídica aplicada en bioética.</li>
                    <li>• Analizar las consecuencias ético-jurídicas del desarrollo de nuevas biotecnologías.</li>
                  </ul>
                </div>
              </div>

            </div>
          </section>

          <!-- TECNOLOGIAS -->
          <section class="break-avoid">
            <h2 class="cv-section-title">Tecnologias</h2>
            <div class="space-y-2 text-xs sm:text-[13px] text-[var(--text-secondary)]">
              <p>
                <strong class="text-[var(--text-main)] font-semibold">Lenguajes y Frameworks:</strong> C#, .NET, JavaScript, SQL, HTML, CSS, Bootstrap, Swift, SwiftUI
              </p>
              <p>
                <strong class="text-[var(--text-main)] font-semibold">Herramientas:</strong> Git, GitHub, Power Automate, Jira, Azure DevOps, Xcode.
              </p>
            </div>
          </section>

        </div>

      </div>

    </main>

    <footer class="no-print max-w-[960px] mx-auto mt-6 text-center text-xs text-[var(--text-muted)]">
      <p>{cvData.name} © {currentYear} • Curriculum Vitae Digital</p>
    </footer>

    <!-- THEME TOGGLE SCRIPT -->
    <script>
      const themeBtn = document.getElementById('theme-btn');
      const themeIcon = document.getElementById('theme-icon');

      function updateTheme() {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        if (themeIcon) {
          themeIcon.textContent = current === 'dark' ? '☼' : '◐';
        }
      }

      updateTheme();

      themeBtn?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateTheme();
      });
    </script>
  </body>
</html>
