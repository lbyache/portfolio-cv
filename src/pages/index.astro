---
import Layout from '../layouts/Layout.astro';
import { cvData } from '../data/cv';
import { url } from '../utils/paths';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import { getCollection } from 'astro:content';

// Get latest blog posts
const posts = await getCollection('blog');
const sortedPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const featuredProjects = cvData.projects.filter(p => p.featured).slice(0, 4);
---

<Layout 
  title={`${cvData.name} — ${cvData.title}`} 
  description={cvData.summary}
>
  <!-- CLEAN MODERN HERO SECTION -->
  <section class="py-12 sm:py-16 max-w-3xl mx-auto text-center">
    
    <!-- AVATAR & AVAILABILITY STATUS -->
    <div class="inline-flex flex-col items-center mb-6">
      <div class="relative mb-3">
        <img 
          src={url(cvData.photo)} 
          alt={cvData.name} 
          class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover border-2 border-[var(--border-color)] shadow-md hover:scale-105 transition-transform duration-300"
        />
        <span class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-[var(--bg-surface)]"></span>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] text-xs font-medium text-[var(--text-secondary)] shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Disponible para nuevos desafíos</span>
      </div>
    </div>

    <!-- MAIN HEADLINE -->
    <h1 class="text-4xl sm:text-5xl font-extrabold text-[var(--text-primary)] tracking-tight leading-tight mb-3">
      {cvData.name}
    </h1>

    <p class="text-base sm:text-lg font-semibold text-[var(--text-muted)] mb-6">
      Desarrolladora C# .NET &amp; iOS • Analista de Sistemas • Abogada (UCA)
    </p>

    <!-- FOCUSED BIO -->
    <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed max-w-2xl mx-auto mb-8">
      Desarrollo aplicaciones empresariales con <strong>C# y .NET</strong>, aplicaciones mobile nativas para <strong>iOS (SwiftUI)</strong> y aplico análisis de negocio combinando tecnología con mi formación en <strong>LegalTech y docencia</strong>.
    </p>

    <!-- CALL TO ACTIONS -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href={url('/cv')} class="btn py-3 px-6 shadow-sm">
        <span>📄</span>
        <span>Ver Curriculum Vitae</span>
      </a>
      <a href="#proyectos" class="btn btn-outline py-3 px-6">
        <span>Explorar Proyectos ↓</span>
      </a>
      <a href={`mailto:${cvData.email}`} class="btn btn-outline py-3 px-5">
        <span>✉ Contactar</span>
      </a>
    </div>

  </section>

  <!-- 3 SPECIALTY CARDS WITH CLEAN VECTOR ICONS -->
  <section class="py-12 border-t border-[var(--border-color)]">
    <div class="text-center max-w-xl mx-auto mb-10">
      <span class="section-tag">Especialidades</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
        Áreas de Enfoque Principal
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="card p-7 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-5 border border-blue-100 dark:border-blue-900/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2">
            Backend &amp; C# .NET
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Mantenimiento y desarrollo de lógica empresarial en Axoft. Optimización de bases de datos SQL y arquitectura limpia con principios SOLID.
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-[var(--border-color)]">
          <span class="badge text-xs">C#</span>
          <span class="badge text-xs">.NET Core</span>
          <span class="badge text-xs">SQL Server</span>
        </div>
      </div>

      <div class="card p-7 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-5 border border-indigo-100 dark:border-indigo-900/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2">
            Mobile iOS (Swift)
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Desarrollo mobile nativo en iOS utilizando Swift y SwiftUI. Arquitectura MVVM, gestión de estado reactivo y consumo de APIs REST.
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-[var(--border-color)]">
          <span class="badge text-xs">Swift</span>
          <span class="badge text-xs">SwiftUI</span>
          <span class="badge text-xs">Xcode</span>
        </div>
      </div>

      <div class="card p-7 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-5 border border-emerald-100 dark:border-emerald-900/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2">
            LegalTech &amp; Docencia
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
            Abogada (UCA), automatización en DHL Express, docente de desarrollo web en Escuela Da Vinci y voluntaria en Mujeres en Tecnología (MeT).
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-[var(--border-color)]">
          <span class="badge text-xs">Power Platform</span>
          <span class="badge text-xs">Docencia Web</span>
          <span class="badge text-xs">MeT</span>
        </div>
      </div>

    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section id="proyectos" class="py-12 border-t border-[var(--border-color)]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <span class="section-tag">Portfolio</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
          Proyectos &amp; Repositorios Destacados
        </h2>
      </div>
      <a 
        href={cvData.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1.5"
      >
        <span>Ver todos en GitHub (@{cvData.githubUsername})</span>
        <span>↗</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- CAREER EXPERIENCE PREVIEW -->
  <section class="py-12 border-t border-[var(--border-color)]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <span class="section-tag">Trayectoria</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
          Experiencia Laboral
        </h2>
      </div>
      <a href={url('/cv')} class="btn btn-outline btn-sm text-xs">
        Ver CV Completo con Educación →
      </a>
    </div>

    <div class="card p-6 sm:p-8">
      <div class="space-y-6">
        {cvData.experience.slice(0, 3).map(exp => (
          <ExperienceCard item={exp} />
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST ESSAYS / BLOG -->
  {sortedPosts.length > 0 && (
    <section class="py-12 border-t border-[var(--border-color)]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="section-tag">Publicaciones</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
            Reflexiones sobre Tecnología, Ética e IA
          </h2>
        </div>
        <a href={url('/blog')} class="text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1">
          Ver todos los artículos →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {sortedPosts.map(post => (
          <article class="card card-hover flex flex-col justify-between p-6">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex flex-wrap gap-1">
                  {post.data.tags.map(tag => (
                    <span class="badge text-[11px]">#{tag}</span>
                  ))}
                </div>
                <span class="text-xs text-[var(--text-muted)] font-mono">
                  {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </div>

              <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2 leading-snug">
                <a href={url(`/blog/${post.id}`)} class="text-inherit no-underline hover:underline">
                  {post.data.title}
                </a>
              </h3>

              <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>

            <div class="pt-3 border-t border-[var(--border-color)] text-right">
              <a href={url(`/blog/${post.id}`)} class="text-xs font-semibold text-[var(--text-primary)] hover:underline inline-flex items-center gap-1">
                Leer artículo completo →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>
