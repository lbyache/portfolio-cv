---
import type { ExperienceItem } from '../data/cv';

interface Props {
  item: ExperienceItem;
  showTimelineDot?: boolean;
}

const { item, showTimelineDot = false } = Astro.props;
---

<div class={`break-avoid ${showTimelineDot ? 'timeline-item' : 'border-b border-[var(--border-color)] pb-7 mb-7 last:border-b-0 last:pb-0 last:mb-0'}`}>
  {showTimelineDot && <div class="timeline-dot"></div>}

  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-3">
    <div>
      <h3 class="font-sans font-bold text-lg sm:text-xl text-[var(--text-primary)] leading-snug">
        {item.role}
      </h3>
      <div class="font-medium text-sm sm:text-base text-[var(--text-secondary)] mt-0.5 flex flex-wrap items-center gap-2">
        <span class="font-semibold text-[var(--text-primary)]">{item.company}</span>
        {item.location && <span class="text-xs text-[var(--text-muted)] font-mono">📍 {item.location}</span>}
      </div>
    </div>

    <div class="flex items-center gap-2 self-start sm:self-auto">
      {item.tag && (
        <span class="badge text-xs">
          {item.tag}
        </span>
      )}
      <span class="font-mono text-xs font-semibold text-[var(--text-primary)] bg-[var(--bg-muted)] px-2.5 py-1 rounded border border-[var(--border-color)]">
        {item.period}
      </span>
    </div>
  </div>

  <ul class="space-y-2 list-disc list-outside pl-4 text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
    {item.bullets.map((bullet) => (
      <li class="pl-1">
        {bullet}
      </li>
    ))}
  </ul>
</div>
