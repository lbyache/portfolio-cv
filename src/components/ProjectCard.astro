---
import type { ProjectItem } from '../data/cv';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<article class="card card-hover flex flex-col justify-between h-full p-6 sm:p-8 group">
  <div>
    <div class="flex items-center justify-between gap-3 mb-4">
      <span class="badge text-xs font-bold px-3 py-1">
        {project.category}
      </span>
      <a 
        href={project.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="font-mono text-xs font-semibold text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-colors inline-flex items-center gap-1.5"
        title="Ver repositorio en GitHub"
      >
        <span>GitHub</span>
        <span class="text-sm">↗</span>
      </a>
    </div>

    <h3 class="font-serif font-bold text-2xl text-[var(--text-primary)] mb-3 group-hover:underline decoration-1 underline-offset-4">
      <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-inherit no-underline">
        {project.title}
      </a>
    </h3>

    <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed mb-6">
      {project.description}
    </p>
  </div>

  <div>
    <div class="flex flex-wrap gap-2 pt-4 border-t border-[var(--border-color)]">
      {project.tech.map((t) => (
        <span class="font-mono text-xs font-medium px-2.5 py-1 rounded bg-[var(--bg-muted)] text-[var(--text-primary)] border border-[var(--border-color)]">
          {t}
        </span>
      ))}
    </div>
  </div>
</article>
