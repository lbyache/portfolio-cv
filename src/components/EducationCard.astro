---
import type { EducationItem } from '../data/cv';

interface Props {
  item: EducationItem;
}

const { item } = Astro.props;
---

<div class="break-avoid border-b border-[var(--border-color)] pb-5 mb-5 last:border-b-0 last:pb-0 last:mb-0">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
    <div>
      <h3 class="font-sans font-bold text-base sm:text-lg text-[var(--text-primary)]">
        {item.degree}
      </h3>
      <p class="text-sm text-[var(--text-secondary)] mt-0.5 font-medium">
        {item.institution}
      </p>
    </div>

    <span class="font-mono text-xs font-semibold text-[var(--text-primary)] bg-[var(--bg-muted)] px-2.5 py-1 rounded border border-[var(--border-color)] self-start sm:self-auto">
      {item.period}
    </span>
  </div>
</div>
