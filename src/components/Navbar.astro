---
import { url } from '../utils/paths';
import { cvData } from '../data/cv';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="navbar no-print sticky top-0 z-50 backdrop-blur-md bg-[var(--bg-primary)]/90 border-b border-[var(--border-color)] transition-colors duration-200">
  <div class="container flex items-center justify-between py-3.5 flex-wrap gap-4">
    <!-- BRAND / LOGO -->
    <a href={url('/')} class="flex items-center gap-2 group text-[var(--text-primary)] no-underline">
      <span class="font-mono text-sm font-bold tracking-tight py-1 px-2 rounded bg-[var(--bg-muted)] border border-[var(--border-color)] group-hover:border-[var(--text-primary)] transition-colors">
        &gt; lbyache.
      </span>
      <span class="font-sans font-semibold text-sm hidden sm:inline text-[var(--text-secondary)]">
        {cvData.name}
      </span>
    </a>

    <!-- NAV LINKS -->
    <nav class="flex items-center gap-1 sm:gap-2">
      <a 
        href={url('/')} 
        class={`font-mono text-xs font-medium px-2.5 py-1.5 rounded transition-colors ${currentPath === '/' ? 'bg-[var(--text-primary)] text-[var(--bg-primary)]!' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-muted)]'}`}
      >
        [INICIO]
      </a>
      <a 
        href={url('/cv')} 
        class={`font-mono text-xs font-medium px-2.5 py-1.5 rounded transition-colors ${currentPath === '/cv' ? 'bg-[var(--text-primary)] text-[var(--bg-primary)]!' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-muted)]'}`}
      >
        [CV_PDF]
      </a>
      <a 
        href={url('/blog')} 
        class={`font-mono text-xs font-medium px-2.5 py-1.5 rounded transition-colors ${currentPath?.startsWith('/blog') ? 'bg-[var(--text-primary)] text-[var(--bg-primary)]!' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-muted)]'}`}
      >
        [BLOG]
      </a>
      <a 
        href={cvData.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="font-mono text-xs font-medium px-2.5 py-1.5 rounded text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-muted)] transition-colors hidden md:inline-flex items-center gap-1"
      >
        GitHub ↗
      </a>
    </nav>

    <!-- RIGHT CONTROLS: THEME TOGGLE & CONTACT -->
    <div class="flex items-center gap-2">
      <button 
        id="theme-toggle-btn" 
        class="btn btn-outline btn-sm font-mono text-xs" 
        aria-label="Cambiar tema claro / oscuro"
      >
        <span id="theme-icon" class="mr-1">◐</span>
        <span id="theme-label">TEMA</span>
      </button>

      <a 
        href={`mailto:${cvData.email}`} 
        class="btn btn-sm hidden sm:inline-flex items-center gap-1.5"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
        <span>Contacto</span>
      </a>
    </div>
  </div>
</header>
