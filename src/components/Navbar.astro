---
import { url } from '../utils/paths';
import { cvData } from '../data/cv';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="navbar no-print sticky top-0 z-50 backdrop-blur-md bg-[var(--bg)]/85 border-b border-[var(--border)] transition-colors duration-150">
  <div class="content-container flex items-center justify-between py-3">
    
    <!-- LEFT: LOGO / NAME -->
    <a href={url('/')} class="flex items-center gap-2.5 group text-[var(--text)] no-underline">
      <img 
        src={url(cvData.photo)} 
        alt={cvData.name} 
        class="w-6 h-6 rounded-full object-cover border border-[var(--border)] shrink-0" 
      />
      <span class="text-sm font-semibold tracking-tight text-[var(--text)]">
        {cvData.name}
      </span>
    </a>

    <!-- RIGHT: NAVIGATION LINKS & ACTIONS -->
    <nav class="flex items-center gap-3 sm:gap-4 text-xs font-medium text-[var(--text-secondary)]">
      <a href="#experiencia" class="hover:text-[var(--text)] transition-colors hidden sm:inline-block">
        Experiencia
      </a>
      <a href="#proyectos" class="hover:text-[var(--text)] transition-colors hidden sm:inline-block">
        Proyectos
      </a>
      <a href="#educacion" class="hover:text-[var(--text)] transition-colors hidden sm:inline-block">
        Educación
      </a>
      <a href={url('/cv')} class="text-[var(--text)] font-semibold hover:underline">
        CV (PDF)
      </a>

      <!-- THEME TOGGLE BUTTON -->
      <button 
        id="theme-toggle-btn" 
        class="p-1.5 rounded-md hover:bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer" 
        aria-label="Cambiar tema claro / oscuro"
        title="Cambiar tema"
      >
        <span id="theme-icon" class="text-xs">◐</span>
      </button>
    </nav>

  </div>
</header>
